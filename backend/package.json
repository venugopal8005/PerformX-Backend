{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test test/*.test.js",
    "verify:execution-integrity": "node src/scripts/verifyExecutionIntegrity.js",
    "inspect:phase1e-history-indexes": "node src/scripts/applyPhase1EHistoryIndexes.js --inspect",
    "apply:phase1e-history-indexes": "node src/scripts/applyPhase1EHistoryIndexes.js --apply",
    "inspect:phase2-issue-indexes": "node src/scripts/applyPhase2IssueIndexes.js --inspect",
    "apply:phase2-issue-indexes": "node src/scripts/applyPhase2IssueIndexes.js --apply",
    "inspect:phase3-intervention-indexes": "node src/scripts/applyPhase3InterventionIndexes.js --inspect",
    "apply:phase3-intervention-indexes": "node src/scripts/applyPhase3InterventionIndexes.js --apply",
    "inspect:phase4-evaluation-indexes": "node src/scripts/applyPhase4EvaluationIndexes.js --inspect",
    "apply:phase4-evaluation-indexes": "node src/scripts/applyPhase4EvaluationIndexes.js --apply",
    "migrate:phase2-issues": "node src/scripts/migratePhase2Issues.js --dry-run",
    "verify:archive-topology": "node src/scripts/verifyArchiveTopology.js",
    "backfill:historical-snapshots": "node src/scripts/backfillHistoricalSnapshots.js",
